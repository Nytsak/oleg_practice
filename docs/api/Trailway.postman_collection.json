            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/routes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Перевірка REST API\",\n  \"description\": \"Маршрут із колекції Postman\",\n  \"state\": \"ready\",\n  \"points\": [\n    {\n      \"label_snapshot\": \"Міське озеро\",\n      \"latitude\": 48.91412,\n      \"longitude\": 24.68918\n    },\n    {\n      \"label_snapshot\": \"Парк Шевченка\",\n      \"latitude\": 48.91194,\n      \"longitude\": 24.69895\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) { const data = pm.response.json();",
              "pm.collectionVariables.set(\"route_id\", data.id);",
              "pm.collectionVariables.set(\"route_version\", data.version);",
              "}"
            ]
          }
        }
      ]
    },
