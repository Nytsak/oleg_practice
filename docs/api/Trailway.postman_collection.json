{
  "info": {
    "name": "Trailway Labs 8–10",
    "description": "Запустіть npm start, імпортуйте колекцію та виконуйте запити по порядку. Postman зберігає HttpOnly cookie у cookie jar; access_token, UUID і version передаються автоматично. Колекція створює власний маршрут і видаляє його; завершена подорож лишається в історії.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "route_id",
      "value": ""
    },
    {
      "key": "route_version",
      "value": "1"
    },
    {
      "key": "trip_id",
      "value": ""
    },
    {
      "key": "share_id",
      "value": ""
    },
    {
      "key": "share_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Стан API",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Вхід туриста",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"oleh@example.com\",\n  \"password\": \"Tourist2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) { const data = pm.response.json();",
              "pm.collectionVariables.set(\"access_token\", data.access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Поточний користувач",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
